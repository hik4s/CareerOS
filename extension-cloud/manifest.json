{
  "manifest_version": 3,
  "name": "CareerOS Cloud \u2014 Capturar vaga",
  "version": "1.0.0",
  "description": "Captura uma vaga para sua conta CareerOS ap\u00f3s sua aprova\u00e7\u00e3o.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "action": {
    "default_title": "CareerOS Cloud",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
