{
  "manifest_version": 3,
  "name": "Career OS - Capturar Vaga",
  "version": "0.1.0",
  "description": "Captura a vaga aberta e envia para o Career OS local.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": {"default_title": "Capturar vaga", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"}
}
